{
  "compilerOptions": {
    /* ===== Language & Environment ===== */
    "target": "ES2020",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    /* ===== Module System ===== */
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": false,
    /* ===== React ===== */
    "jsx": "react-jsx",
    /* ===== Type Safety ===== */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    /* ===== Build & Tooling ===== */
    "noEmit": true,
    "isolatedModules": true,
    "incremental": true,
    /* ===== Interop ===== */
    "esModuleInterop": true,
    /* ===== Path Aliases ===== */
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    /* ===== Next.js ===== */
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
